    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.8.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
