{
  "name": "repopilot-ai",
  "version": "0.1.0",
  "description": "Offline-first Git chore automation powered by local Ollama models.",
  "type": "module",
  "bin": {
    "repopilot": "dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "README.md",
    "LICENSE",
    "scripts/demo.mjs"
  ],
  "scripts": {
